# Offline knowledge-base corpus (FICTIONAL). One JSON object per line. Fields: passage_id, title,
# text, market, locale, vertical, audience, source_ref. The local retrieval adapter ranks by
# normalised term overlap and every passage carries the citation a drafted reply is traced
# through. No real institution appears here, and no figure in a suggested reply can exist unless
# it is in one of these lines.
#
# `audience` says who the passage was written FOR, and it is REQUIRED on every row. A contact
# centre's corpus holds both halves: what a customer may be told ("public"), and how staff are
# meant to handle it ("internal"). They read alike and they are not alike. Self-service may
# ground a reply only in public rows; agent-assist may see both, because a trained employee is
# meant to. An unclassified row is refused at load rather than filtered at query time, since a
# filter cannot exclude on a field that is absent.
#
# `source_ref` is the published document a person could actually look up. A citation that
# resolves only inside the bank is provenance for the bank, not for the person being told
# something.
#
# kb-sg-002 used to carry both halves in one row: the publishable rule about which
# transactions are listed, and the internal reason pending authorisations are withheld. As
# one row it was staff wording sitting in the only pool a customer-facing reply could be
# grounded in, which is exactly what the classification exists to separate.
{"passage_id": "kb-sg-001", "title": "Card balance enquiries", "text": "The current card balance may be given once the caller has been verified. The balance quoted is the posted balance and excludes transactions still in authorisation.", "market": "SG", "locale": "en-SG", "vertical": "retail_banking", "audience": "public", "source_ref": "demo-bank.example/help/card-balance"}
{"passage_id": "kb-sg-002", "title": "Recent transaction listing", "text": "The last five posted transactions may be read out after verification. Transactions still in authorisation are not listed until they post.", "market": "SG", "locale": "en-SG", "vertical": "retail_banking", "audience": "public", "source_ref": "demo-bank.example/help/recent-transactions"}
{"passage_id": "kb-sg-003", "title": "Lost or stolen cards", "text": "A lost card is blocked immediately on the caller request and a replacement is despatched. The replacement arrives within 5 working days and the card number changes.", "market": "SG", "locale": "en-SG", "vertical": "retail_banking", "audience": "public", "source_ref": "demo-bank.example/help/lost-card"}
{"passage_id": "kb-sg-004", "title": "Disputed transactions", "text": "A disputed transaction is investigated and provisional credit may be applied while the investigation runs. The investigation takes up to 45 days and the caller keeps the right to dispute in writing.", "market": "SG", "locale": "en-SG", "vertical": "retail_banking", "audience": "public", "source_ref": "demo-bank.example/help/disputed-transactions"}
{"passage_id": "kb-sg-005", "title": "Call recording and data use", "text": "Calls are recorded for quality and training. The caller is told at the start of the call and the information collected is used to service the account.", "market": "SG", "locale": "en-SG", "vertical": "retail_banking", "audience": "public", "source_ref": "demo-bank.example/legal/call-recording"}
{"passage_id": "kb-sg-006", "title": "Supervisor referral", "text": "A case is referred to a supervisor when two identity checks fail in one contact, or when the same caller reaches the centre three times within seven days. The referral note records which check failed.", "market": "SG", "locale": "en-SG", "vertical": "retail_banking", "audience": "internal", "source_ref": "ops-handbook/cards/supervisor-referral"}
{"passage_id": "kb-sg-007", "title": "Conduct logging codes", "text": "A complaint is logged under its conduct code before the contact ends. The code names the product line rather than the outcome, so a later review can group cases by product.", "market": "SG", "locale": "en-SG", "vertical": "retail_banking", "audience": "internal", "source_ref": "ops-handbook/conduct/logging-codes"}
{"passage_id": "kb-jp-001", "title": "カード残高のお問い合わせ", "text": "ご本人確認のうえ、カードの残高をお伝えします。お伝えするのは計上済みの残高で、承認中のお取引は含みません。", "market": "JP", "locale": "ja-JP", "vertical": "retail_banking", "audience": "public", "source_ref": "demo-bank.example/jp/help/card-balance"}
{"passage_id": "kb-jp-002", "title": "ご利用明細のお問い合わせ", "text": "ご本人確認のうえ、直近五件の計上済みのお取引をお伝えします。承認中のお取引は計上されるまでお伝えしません。", "market": "JP", "locale": "ja-JP", "vertical": "retail_banking", "audience": "public", "source_ref": "demo-bank.example/jp/help/recent-transactions"}
{"passage_id": "kb-jp-003", "title": "カードの紛失と盗難", "text": "紛失したカードはお申し出により直ちに利用停止となり、代替カードをお送りします。お手元に届くまで五営業日ほどかかり、カード番号は変更となります。", "market": "JP", "locale": "ja-JP", "vertical": "retail_banking", "audience": "public", "source_ref": "demo-bank.example/jp/help/lost-card"}
{"passage_id": "kb-jp-004", "title": "通話の録音と情報の利用", "text": "品質向上と研修のため通話を録音しております。通話の冒頭でお客様にお伝えし、取得した情報は口座のご提供のために利用します。", "market": "JP", "locale": "ja-JP", "vertical": "retail_banking", "audience": "public", "source_ref": "demo-bank.example/jp/legal/call-recording"}
{"passage_id": "kb-jp-005", "title": "上席への引き継ぎ基準", "text": "一回の通話で本人確認が二回失敗した場合、または七日以内に同じお客様から三回のお問い合わせがあった場合は上席に引き継ぎます。", "market": "JP", "locale": "ja-JP", "vertical": "retail_banking", "audience": "internal", "source_ref": "ops-handbook/jp/cards/supervisor-referral"}
{"passage_id": "kb-sgi-001", "title": "What your motor policy covers", "text": "A comprehensive motor policy covers accidental damage to your own vehicle, third party injury and third party property damage. The period of cover and the sum insured are shown on your policy schedule.", "market": "SG", "locale": "en-SG", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/help/motor-cover"}
{"passage_id": "kb-sgi-002", "title": "Excess payable on a motor claim", "text": "An excess is the amount you pay towards a claim before the insurer pays the rest. The excess for your cover category is shown on your policy schedule and is deducted from the settlement.", "market": "SG", "locale": "en-SG", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/help/motor-excess"}
{"passage_id": "kb-sgi-003", "title": "Making a motor claim", "text": "A claim is lodged by telling the insurer when and where the incident happened and whether anyone was injured. An assessor makes contact after the claim is lodged and a claim reference is issued at the time of the call.", "market": "SG", "locale": "en-SG", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/help/making-a-claim"}
{"passage_id": "kb-sgi-004", "title": "Premium instalments", "text": "Premiums are payable by instalment on the date shown on your schedule. A missed instalment does not cancel cover immediately, and the insurer writes to you before any cover lapses.", "market": "SG", "locale": "en-SG", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/help/premium-instalments"}
{"passage_id": "kb-sgi-005", "title": "Significant exclusions on a motor policy", "text": "A motor policy does not cover use of the vehicle for hire or reward unless that extension was bought, wear and tear, or loss while the vehicle was driven by an unlicensed driver.", "market": "SG", "locale": "en-SG", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/help/motor-exclusions"}
{"passage_id": "kb-sgi-006", "title": "Complaints route", "text": "A complaint is raised first through internal dispute resolution and the customer is told they can refer the matter to the external scheme if the outcome does not satisfy them.", "market": "SG", "locale": "en-SG", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/legal/complaints"}
{"passage_id": "kb-sgi-007", "title": "Assessor allocation thresholds", "text": "A claim under the desk-assessment limit is settled without a site visit. Above it, allocate a field assessor within two working days and note the reason on the file.", "market": "SG", "locale": "en-SG", "vertical": "general_insurance", "audience": "internal", "source_ref": "ops-handbook/claims/assessor-allocation"}
{"passage_id": "kb-jpi-001", "title": "自動車保険の補償範囲", "text": "車両保険では、ご自身のお車の損害、第三者への賠償、対物賠償を補償します。保険期間と保険金額はご契約のしおりに記載しています。", "market": "JP", "locale": "ja-JP", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/jp/help/motor-cover"}
{"passage_id": "kb-jpi-002", "title": "免責金額について", "text": "免責金額とは、保険金のお支払いに際してお客様にご負担いただく金額です。ご契約の免責金額はしおりに記載しており、お支払額から差し引きます。", "market": "JP", "locale": "ja-JP", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/jp/help/motor-excess"}
{"passage_id": "kb-jpi-003", "title": "事故のご連絡", "text": "事故のご連絡では、発生日時、発生場所、お怪我の有無をお伺いします。受付後に担当者からご連絡し、受付番号はお電話の際にお伝えします。", "market": "JP", "locale": "ja-JP", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/jp/help/making-a-claim"}
{"passage_id": "kb-jpi-004", "title": "保険料のお支払い", "text": "保険料はご契約のしおりに記載の日に分割でお支払いいただきます。お支払いがない場合でも直ちに解約とはならず、補償が終了する前に書面でご案内します。", "market": "JP", "locale": "ja-JP", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/jp/help/premium-instalments"}
{"passage_id": "kb-jpi-005", "title": "補償対象外となる場合", "text": "自動車保険では、特約のない有償運送のご使用、経年劣化、無免許運転中の損害は補償対象外となる場合があります。", "market": "JP", "locale": "ja-JP", "vertical": "general_insurance", "audience": "public", "source_ref": "demo-insurer.example/jp/help/motor-exclusions"}
{"passage_id": "kb-jpi-006", "title": "査定担当者の割り当て基準", "text": "机上査定の上限額を下回る請求は現地調査を行いません。上回る場合は二営業日以内に現地の査定担当者を割り当て、理由を記録します。", "market": "JP", "locale": "ja-JP", "vertical": "general_insurance", "audience": "internal", "source_ref": "ops-handbook/jp/claims/assessor-allocation"}
