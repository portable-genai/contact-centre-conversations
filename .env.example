# Contact Centre AI (E1): non-secret example environment.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored). Secret VALUES belong
# only in `.env.secrets`, copied from `.env.secrets.example`. Nothing here is a secret, and every
# name below is referenced from `config/settings.yaml` or read directly by the service.
#
# The offline stack needs no cloud credential and no SDK, but it still needs the profile below
# to be NAMED: absence is not consent, and an unnamed profile refuses rather than relaxing.

# ---------------------------------------------------------------------------
# Profile
# ---------------------------------------------------------------------------
# local | gcp | onprem, in three states:
#
#   UNSET               nobody chose. The SDK-free adapters still bind (the alternative is
#                       importing cloud SDKs that are not installed), but every relaxation is
#                       withdrawn: no seeded dev personas, no dev CORS allowlist, no
#                       X-Dev-Persona header, no service-to-service scheme, HSTS on, and the
#                       exposure guard refuses every route to any non-loopback peer. A
#                       deployment that lost this variable fails visibly instead of serving.
#   SET AND EMPTY       refused AT BOOT. An emptied variable is an expressed intent that names
#                       no profile, so it never inherits the unset behaviour.
#   SET AND UNKNOWN     refused AT BOOT, including a merely mis-capitalised `Local` or `GCP`.
#   SET AND VALID       honoured exactly.
#
# Name it. This is the offline demo value:
CONTACT_PROFILE=local

# Point at a different settings file. A path that is named but missing is a boot error; leave
# this unset to use ./config/settings.yaml.
CONTACT_SETTINGS=

# ---------------------------------------------------------------------------
# The two separately gated modes
# ---------------------------------------------------------------------------
# E1 is one service with TWO modes that promote apart: agent-assist is internal decision-support
# beside a live human agent, self-service is customer-facing. Each is its own Hrz4 gated release
# with its own rubric set, so each is enabled on its own and each names the promotion bundle whose
# evidence authorised it.
#
# BOTH DEFAULT OFF, in the same three states as the profile:
#
#   UNSET             takes the `off` written in config/settings.yaml. A deployment that
#                     configured nothing serves no mode, and every mode route answers 503.
#   SET AND EMPTY     refused AT BOOT. An emptied flag names no state and does not inherit `off`.
#   SET AND UNKNOWN   refused AT BOOT, including a mis-capitalised `On`.
#   SET AND VALID     on | true | 1 | yes | enabled, or off | false | 0 | no | disabled.
#
# A mode enabled with an EMPTY bundle refuses to boot under any profile but a deliberate `local`:
# shipping a customer-facing mode on somebody else's rubric run is the failure that check removes.
CONTACT_AGENT_ASSIST=off
# CONTACT_AGENT_ASSIST_BUNDLE=
CONTACT_SELF_SERVICE=off
# CONTACT_SELF_SERVICE_BUNDLE=

# ---------------------------------------------------------------------------
# Reviewed policy packs and offline fixtures
# ---------------------------------------------------------------------------
# The bank's procedures, disclosures, allowlists, action catalog and customer cues, as DATA. They
# are validated at boot; a pack that names a state or an action nothing defines stops the process
# rather than becoming a rule that silently never fires. A MISSING directory yields the empty
# library, which refuses everything (an empty allowlist admits nobody).
CONTACT_PACKS_PATH=config/packs

# The offline knowledge base the local retrieval adapter grounds against, and the scripted
# contacts the local speech and channel adapters replay. Fixtures: the managed family reaches
# Hrz2 and the real recogniser instead.
CONTACT_KB_PATH=config/kb/passages.jsonl
CONTACT_STREAMS_PATH=config/streams

# ---------------------------------------------------------------------------
# Sibling services the platform-remote adapters call
# ---------------------------------------------------------------------------
# UNSET means UNCONFIGURED, and an unconfigured remote dependency refuses at the adapter rather
# than defaulting to localhost. Leave the line commented out to say nothing; SETTING one to an
# empty value is a different act and the settings loader refuses it at boot, naming the
# variable. Outside loopback each must be https://.
# KNOWLEDGE_BASE_URL=
# GUARDRAIL_GATEWAY_URL=
# CONTACT_TOOL_CATALOG_URL=

# The managed model the generation adapter asks for. Configuration, never a literal in a module,
# so routing to a smaller model is not a code change.
CONTACT_MODEL=gemini-3.5-flash

# The Hrz4 quality service the promotion gate asks for a verdict. Unset takes the documented
# default; an EMPTIED value refuses rather than silently asking localhost for a promotion.
CONTACT_QUALITY_URL=

# ---------------------------------------------------------------------------
# Serving posture
# ---------------------------------------------------------------------------
# A posture whose identity adapter cannot verify an end user (the seeded personas, the on-prem
# placeholder, or no profile at all) binds loopback and refuses non-loopback peers. Set this to 1
# ONLY to accept that exposure deliberately (a demo on a trusted LAN); nothing else opts out, and
# in particular setting the inbound S2S token below does not.
CONTACT_ALLOW_INSECURE_DEMO=
# Explicit bind host. Set-and-empty is refused rather than inheriting the profile default.
CONTACT_API_HOST=
# Comma-separated CORS allowlist. Never falls back to "*", and an EMPTY value denies rather than
# restoring the localhost dev origins.
CONTACT_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Inbound service-to-service authentication (this service as the callee)
# ---------------------------------------------------------------------------
# The bearer other services present to /v1/audit/ping and friends. UNSET is the documented
# zero-secret loopback dev opening; SET-AND-EMPTY is a 503 under every profile.
# The VALUE belongs in .env.secrets, not here.
CONTACT_S2S_ALLOWED_CALLERS=
CONTACT_S2S_AUDIENCE=

# ---------------------------------------------------------------------------
# Rule R8: outbound human-review routing (this service as the caller)
# ---------------------------------------------------------------------------
# The Hrz7 Human-Review and Maker-Checker Console. HTTPS is required off loopback. The managed
# profile REFUSES to swallow an escalation when this is unconfigured, so R8 cannot be quietly
# unwired. Leave it commented out to say nothing; setting it empty refuses at boot instead.
# HUMAN_REVIEW_URL=
# Tenant partition asserted on outbound reviews when the verified principal carries none.
# CONTACT_TENANT=
# HUMAN_REVIEW_S2S_TOKEN and HUMAN_REVIEW_S2S_SIGNING_KEY are the OUTBOUND credentials; they live in .env.secrets.

# ---------------------------------------------------------------------------
# Local profile stores
# ---------------------------------------------------------------------------
# Path of the hash-chained WORM audit log. ":memory:" is ephemeral (what the gate uses).
CONTACT_AUDIT_PATH=:memory:
# External head anchor for that log, on a DIFFERENT volume and under different credentials.
# Without it a truncated tail is undetectable: the remaining chain still verifies. Required for
# any durable audit path; leave unset only for the ephemeral in-memory store.
# CONTACT_AUDIT_ANCHOR=

# ---------------------------------------------------------------------------
# Managed profile (gcp)
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project
# Residency is selected once and shared by the runtime and Terraform.
GCP_REGION=asia-southeast1
# Audience the IAP identity adapter verifies the signed assertion against: the IAP-protected
# resource, "/projects/<PROJECT_NUMBER>/global/backendServices/<BACKEND_SERVICE_ID>" behind an
# HTTPS load balancer. REQUIRED under the gcp profile, in three states where two of them refuse:
#
#   UNSET / SET AND EMPTY   no assertion can be verified, so every end-user route answers 503
#                           naming this variable. There is deliberately NO unverified fallback:
#                           google-auth documents audience=None as "the audience is not
#                           verified", which accepts ANY Google-signed OIDC token from any
#                           project or application and reads its email as a verified principal.
#   SET AND VALID           the assertion must be addressed to exactly this resource.
#
# Read through `iap_audience` in config/settings.yaml. Not a secret: it names a resource.
# CONTACT_IAP_AUDIENCE=

# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------
# Hrz4 AI-quality service, the promotion authority for `eval/run_eval.py --mode gate`.
CONTACT_QUALITY_URL=http://localhost:8084

# ---------------------------------------------------------------------------
# Telephony voice gateway (docs/voice-gateway.md, docs/cisco-connection-guide.md)
# ---------------------------------------------------------------------------
# The gateway serves only from `contact_centre_conversations voice-gateway` (make run-voice)
# and refuses unless self-service mode is enabled. The bind host derives from the profile the
# same way the HTTP surface's does (mirrors CONTACT_API_HOST / CONTACT_ALLOW_INSECURE_DEMO):
#   CONTACT_VOICE_LAN_DEMO  the ONLY deliberate LAN-exposure opt-in for the local profile.
#                           Set it to exactly 1 to bind beyond loopback for a LAN softphone
#                           demo; anything else keeps the gateway on loopback.
# CONTACT_VOICE_LAN_DEMO=
#   CONTACT_VOICE_HOST      three-state host override for a fronted profile: unset takes the
#                           profile default, set-and-empty refuses, a value binds it.
# CONTACT_VOICE_HOST=
# CONTACT_SIP_PORT=5060
# CONTACT_RTP_PORT_MIN=40000
# CONTACT_RTP_PORT_MAX=40100
# Trunk addresses allowed to send signalling (the CUBE side): comma-separated IPs or CIDRs.
# Unset means loopback peers only; a wildcard is refused at startup in every spelling.
# CONTACT_SIP_PEER_ALLOWLIST=192.0.2.5, 192.0.2.6
# Where a handoff REFERs the caller: a full SIP URI, or bare digits the trunk's dial-peers
# route. Unset means no transfer target exists and a handoff ends the call after the spoken
# handoff line.
# CONTACT_VOICE_TRANSFER_TARGET=2000
# The voice engine BINDING is a config edit, not an env var: to run Gemini Live instead of the
# cascade, edit the voice_engine gcp line in config/settings.yaml AND DEFAULT_BINDINGS in
# config.py (the drift test enforces the two agree), after reading docs/voice-gateway.md.
# Managed voice-path names (configuration, never literals in an adapter):
# CONTACT_VOICE_TTS_VOICE=en-US-Chirp3-HD-Kore
# CONTACT_VOICE_STT_MODEL=telephony_short
# CONTACT_VOICE_LIVE_MODEL=gemini-live-2.5-flash-native-audio
# The Live API serves US and EU regions only today; its region is DELIBERATELY separate from
# GCP_REGION so the residency deviation is a stated choice, never an accident.
# CONTACT_VOICE_LIVE_REGION=us-central1
# CONTACT_VOICE_LIVE_ENDPOINT=vertex
# Cross-channel continuity: how often a live call polls the contact store for chat turns
# arriving mid-call, in milliseconds. Zero disables the bridge.
# CONTACT_VOICE_CHAT_POLL_MS=1000
# CONTACT_VOICE_MARKET=SG
# CONTACT_VOICE_LOCALE=en-SG
